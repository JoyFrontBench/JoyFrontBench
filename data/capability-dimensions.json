{
  "version": 2,
  "method": {
    "taxonomy": "8 capability dimensions (single-axis layered taxonomy)",
    "dimensions": [
      {
        "name": "组件完备",
        "description": "要求的组件、模块、信息或技术实现是否齐全"
      },
      {
        "name": "表征保真",
        "description": "静止画面是否准确还原数据、实体或真实结构"
      },
      {
        "name": "视觉品质",
        "description": "整体审美、风格、构图和视觉语言是否统一"
      },
      {
        "name": "交互响应",
        "description": "点击、拖拽、滚动或键盘操作能否响应并走通"
      },
      {
        "name": "计算渲染",
        "description": "变化后的内容、数值或画面是否算对并连贯更新"
      },
      {
        "name": "规则仿真",
        "description": "底层规则、物理机制、状态机或确定性算法是否成立"
      },
      {
        "name": "状态管理",
        "description": "跨操作、跨视图或跨刷新状态是否被记住并保持一致"
      },
      {
        "name": "数据交换",
        "description": "数据跨系统边界导入导出时内容和格式是否正确"
      }
    ],
    "labeling": "single-label",
    "labeling_unit": "task",
    "decision_rule": "Classify by the hardest assertion in criteria. Behavioral tie-break: 规则仿真 > 状态管理 > 计算渲染 > 交互响应.",
    "manual_review_rule": "Only use 待人工判定 when none of the eight dimensions applies."
  },
