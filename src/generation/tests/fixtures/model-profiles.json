      "model": "reasoning_roundtrip_model",
      "aliases": [
        "reasoning_roundtrip_model_alias"
      ],
      "enabledEnv": "TEST_MODEL_ENABLED",
      "apiBase": "https://api.example.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "contextTokens": 1000000,
      "request": {
        "maxTokens": 131072,
        "maxTokensField": "max_tokens",
        "temperature": null,
        "topP": null,
        "extraBody": {
          "thinking": {
