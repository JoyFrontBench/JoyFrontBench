      "contextTokens": 1000000,
      "request": {
        "maxTokens": 131072,
        "maxTokensField": "max_tokens",
        "temperature": null,
        "topP": null,
        "extraBody": {
          "enable_thinking": true,
          "separate_reasoning": true
        }
      },
      "reasoningEffort": {
        "requestPath": [
          "reasoning_effort"
        ],
        "levels": [
          "high"
        ],
        "default": "high"
      },
      "compatibility": {
        "retryModelServiceErrors": true
      }
