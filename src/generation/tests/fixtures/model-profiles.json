{
  "version": 2,
  "defaults": {
    "apiBase": "https://api.example.com/v1",
    "apiKeyEnv": "OPENAI_API_KEY",
    "authType": "bearer",
    "litellmProvider": "openai",
    "retries": 3,
    "timeoutMs": 3600000,
    "wireApi": "chat.completions"
  },
  "models": {
    "chat_model": {
      "label": "chat_model",
      "model": "chat_model",
      "aliases": [
        "chat_model_alias"
      ],
      "enabledEnv": "TEST_MODEL_ENABLED",
      "contextTokens": 1000000,
      "request": {
        "maxTokens": 131072,
        "maxTokensField": "max_tokens",
        "temperature": 1,
        "topP": 0.95,
        "extraBody": {
          "chat_template_kwargs": {
            "enable_thinking": true
          },
          "separate_reasoning": true
        }
      },
      "reasoningEffort": {
        "requestPath": [
          "reasoning_effort"
        ],
        "levels": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh"
        ],
        "default": "high"
      },
      "apiKeyEnv": "OPENAI_API_KEY",
      "apiBase": "https://api.example.com/v1",
      "compatibility": {
        "retryModelServiceErrors": true
      }
    },
    "tool_chat_model": {
      "label": "tool_chat_model",
      "model": "tool_chat_model",
      "aliases": [
        "tool_chat_model_alias"
      ],
      "apiBase": "https://api.example.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "enabledEnv": "TEST_MODEL_ENABLED",
      "contextTokens": 1000000,
      "opencode": {
        "initialToolChoice": "required"
      },
      "request": {
        "maxTokens": 131072,
        "maxTokensField": "max_tokens",
        "temperature": null,
        "topP": null,
        "extraBody": {
          "separate_reasoning": true
        }
      },
      "reasoningEffort": {
        "requestPath": [
          "reasoning_effort"
        ],
        "levels": [
          "low",
          "high",
          "max"
        ],
        "default": "high"
      },
      "compatibility": {
        "flattenTextContent": true,
        "roundTripReasoningContent": true,
        "retryModelServiceErrors": true
      }
    },
    "reasoning_chat_model": {
      "label": "reasoning_chat_model",
      "model": "reasoning_chat_model",
      "aliases": [
        "reasoning_chat_model_alias"
      ],
      "enabledEnv": "TEST_MODEL_ENABLED",
      "contextTokens": 1000000,
      "request": {
        "maxTokens": 131072,
        "maxTokensField": "max_tokens",
        "temperature": null,
        "topP": null,
        "extraBody": {
          "enable_thinking": true,
          "separate_reasoning": true
        }
      },
      "reasoningEffort": {
        "requestPath": [
          "reasoning_effort"
        ],
        "levels": [
          "high"
        ],
        "default": "high"
      },
      "apiKeyEnv": "OPENAI_API_KEY",
      "apiBase": "https://api.example.com/v1",
      "compatibility": {
        "retryModelServiceErrors": true
      }
    },
    "alternate_chat_model": {
      "label": "alternate_chat_model",
