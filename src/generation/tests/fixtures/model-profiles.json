      ],
      "enabledEnv": "TEST_MODEL_ENABLED",
      "apiBase": "https://api.example.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "authType": "bearer",
      "requestIdHeader": "X-Request-ID",
      "contextTokens": 200000,
      "request": {
        "maxTokens": 131072,
        "maxTokensField": "max_tokens",
        "temperature": 0,
        "topP": null,
        "extraBody": {
          "doSample": false,
          "timeout": 300000,
          "separate_reasoning": true,
