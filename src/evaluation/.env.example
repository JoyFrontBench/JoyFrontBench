# Copy this file to the repository-root .env. docker-run.sh loads it automatically.
# src/evaluation/.env remains supported as a fallback when the root .env is absent.
# Never commit real API keys or Codex credentials.
# Variables already set in the current shell take precedence over this file.

OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
EVAL_MODEL=gpt-5.5
